# GitHub OAuth App Client ID (optional – enables Device Flow login)
# Public value only. Do NOT put PATs or other secrets in any VITE_* variable.
# Create an OAuth App at: https://github.com/organizations/pendler-alarm/settings/applications
# Set the callback URL to your app URL (Device Flow doesn't need a callback)
VITE_GITHUB_CLIENT_ID=

# Comma-separated list of GitHub logins allowed to access the dashboard.
# Leave empty to allow any authenticated GitHub user.
VITE_ALLOWED_USERS=user1,user2,user3

# Comma-separated list of repositories excluded from dashboard data and filters.
VITE_REPO_BLACKLIST=dashboard_old
